{
  "name": "@wa/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @wa/contracts build && next dev --hostname 127.0.0.1",
    "build": "pnpm --filter @wa/contracts build && next build",
    "start": "next start --hostname 127.0.0.1",
    "test:e2e": "pnpm --filter @wa/contracts build && node --test e2e/session.test.mjs",
    "typecheck": "pnpm --filter @wa/contracts build && next typegen && tsc --noEmit",
    "lint": "eslint src next.config.mjs --max-warnings=0"
  },
  "dependencies": {
    "@wa/contracts": "workspace:*",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "5.9.3"
  }
}
