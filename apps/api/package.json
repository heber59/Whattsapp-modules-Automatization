{
  "name": "@wa/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node src/main.ts",
    "dev:worker": "ts-node src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "node --require ts-node/register --test src/shared/config/config.spec.ts",
    "test:e2e": "node --require ts-node/register --test test/*.e2e-spec.ts",
    "lint": "eslint src test --max-warnings=0",
    "test:e2e:api": "node --require ts-node/register --test test/health.e2e-spec.ts test/security.e2e-spec.ts test/http-config.e2e-spec.ts",
    "test:e2e:worker": "node --require ts-node/register --test test/worker.e2e-spec.ts",
    "db:migrate": "ts-node src/shared/database/migrate.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/config": "12.1.1",
    "@wa/contracts": "workspace:*",
    "bullmq": "6.7.2",
    "ioredis": "^6.0.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7",
    "@supabase/supabase-js": "2.119.0",
    "@nestjs/swagger": "12.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "@nestjs/testing": "12.4.0"
  },
  "files": [
    "dist",
    "migrations"
  ]
}
