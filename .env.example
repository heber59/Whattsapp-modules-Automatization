# Local development only. Copy to .env in the repository root.
NODE_ENV=development
PORT=3001
HTTP_HOST=127.0.0.1
# Empty by default. Set only the ingress proxy IPs/CIDRs for the deployed network.
TRUSTED_PROXIES=
WEB_ORIGIN=http://localhost:3000
POSTGRES_USER=wa
POSTGRES_PASSWORD=wa_local_only
POSTGRES_DB=wa
POSTGRES_PORT=55432
REDIS_PORT=56379
DATABASE_URL=postgresql://wa:wa_local_only@127.0.0.1:55432/wa
REDIS_URL=redis://127.0.0.1:56379

# Authentication: configure both values to enable private routes.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
RATE_LIMIT_IP_LIMIT=120
RATE_LIMIT_USER_LIMIT=60
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_ACCOUNT_LIMIT=5
# Browser sessions: use the same random secret (32+ characters) in the API
# environment and apps/web/.env.local. Generate one with: openssl rand -hex 32
# WEB_AUTH_SECRET=
# Next server only. Configure this in apps/web/.env.local or the web service.
# API_INTERNAL_URL=http://127.0.0.1:3001
# Set WEB_ORIGIN in the Next environment to the exact public browser origin.
